# the sources of remote packages, downloaded by portia
/src/pkg/

# the hello example, compiled by whoever plays with it
/obj/*/hello.Obj
/obj/*/hello.Sym

# vocsync (src/test), compiled when modules are copied to or from voc
/obj/*/vocsync.Obj
/obj/*/vocsync.Sym

# tool texts of remote packages, installed by portia
/tools/Calc.Tool
/tools/IFS.Tool
/tools/Iris.Tool

# portia: the package tree (portia.Sync), the record of this installation
/arden/
/portia.world.*
/portia.*.old
/portia.x86
/portia.arm
/portia.armv7
/portia.riscv
/portia.mips

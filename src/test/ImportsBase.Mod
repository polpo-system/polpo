  v170*, v171*, v172*, v173*, v174*, v175*, v176*, v177*, v178*, v179*: LONGINT;
  v180*, v181*, v182*, v183*, v184*, v185*, v186*, v187*, v188*, v189*: LONGINT;
  v190*, v191*, v192*, v193*, v194*, v195*, v196*, v197*, v198*, v199*: LONGINT;

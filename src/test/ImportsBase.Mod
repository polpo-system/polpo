  v260*, v261*, v262*, v263*, v264*, v265*, v266*, v267*, v268*, v269*: LONGINT;
  v270*, v271*, v272*, v273*, v274*, v275*, v276*, v277*, v278*, v279*: LONGINT;
  v280*, v281*, v282*, v283*, v284*, v285*, v286*, v287*, v288*, v289*: LONGINT;
  v290*, v291*, v292*, v293*, v294*, v295*, v296*, v297*, v298*, v299*: LONGINT;

TYPE
  H* = RECORD rh*, lh*, b0*, b1*: LONGINT END;
  Q* = RECORD b0*, b1*, b2*, b3*: LONGINT END;
  W* = RECORD int*: LONGINT; gr*: LONGREAL; hh*: H; qqqq*: Q END;  (* as TeX's memory words *)
  WA* = POINTER TO ARRAY OF W;
  LA* = POINTER TO ARRAY OF LONGINT;
  Node* = POINTER TO NodeDesc;
  NodeDesc* = RECORD value*: LONGINT END;  (* its type descriptor has an entry above 255 *)

VAR mem*, fi*, eq*: WA; pb*: LA; cs*: LONGINT;

PROCEDURE Twice*(x: LONGINT): LONGINT;  (* an entry above 255 *)
BEGIN RETURN 2 * x
END Twice;

PROCEDURE Last*(): LONGINT;
BEGIN RETURN v299
END Last;

BEGIN
  NEW(mem, 4); NEW(fi, 12); NEW(eq, 8); NEW(pb, 4);
  v0 := 0; v1 := 1; v2 := 2; v3 := 3; v4 := 4;
